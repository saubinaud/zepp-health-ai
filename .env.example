# ============================================
# ZEPP HEALTH AI - CONFIGURACIÓN
# ============================================
# Copia este archivo a .env y configura tus valores
# IMPORTANTE: Nunca compartas este archivo .env con nadie

# ============================================
# BASE DE DATOS POSTGRESQL
# ============================================
# Usuario de PostgreSQL (puedes dejarlo así)
POSTGRES_USER=zepp_user

# ⚠️ CAMBIA ESTO: Contraseña segura para PostgreSQL
POSTGRES_PASSWORD=CAMBIA_ESTA_PASSWORD_POR_UNA_SEGURA

# Nombre de la base de datos (puedes dejarlo así)
POSTGRES_DB=zepp_health

# Puerto de PostgreSQL (solo si necesitas cambiarlo)
POSTGRES_PORT=5432

# URL completa de conexión (actualiza con tu password)
DATABASE_URL=postgresql://zepp_user:CAMBIA_ESTA_PASSWORD_POR_UNA_SEGURA@postgres:5432/zepp_health

# ============================================
# BACKEND - CONFIGURACIÓN GENERAL
# ============================================
# Entorno (production o development)
NODE_ENV=production

# Puerto del backend (8080 es compatible con Cloudflare proxy)
PORT=8080
BACKEND_PORT=8080

# ⚠️ CAMBIA ESTO: Secret para JWT (usa una cadena aleatoria larga)
# Genera uno seguro en: https://www.uuidgenerator.net/
JWT_SECRET=CAMBIA_ESTE_SECRET_POR_UNO_ALEATORIO_Y_LARGO

# ============================================
# ZEPP API - SINCRONIZACIÓN
# ============================================
# Intervalo de sincronización automática en minutos (60 = cada hora)
SYNC_INTERVAL_MINUTES=60

# Rate limit para la API de Zepp (1 request por segundo es seguro)
RATE_LIMIT_REQUESTS_PER_SECOND=1

# Configuración de región API manual (Opcional)
# Si se deja vacío, la app buscará automáticamente la región correcta.
# Ejemplos: api-mifit-de2.huami.com (EU), api-mifit-us2.huami.com (US)
ZEPP_API_BASE_URL=

# ============================================
# OPENAI - ANÁLISIS CON IA
# ============================================
# ⚠️ MUY IMPORTANTE: Tu API Key de OpenAI
# Consíguela en: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-AQUI_VA_TU_API_KEY_DE_OPENAI

# Modelo a usar (gpt-4-turbo-preview es más preciso, gpt-3.5-turbo es más barato)
OPENAI_MODEL=gpt-4-turbo-preview

# Tokens máximos por respuesta (2000 es un buen balance)
OPENAI_MAX_TOKENS=2000

# ============================================
# NOTIFICACIONES - UMBRALES DE ALERTA
# ============================================
# Habilitar sistema de notificaciones
ENABLE_NOTIFICATIONS=true

# Frecuencia cardíaca alta (bpm)
NOTIFICATION_HR_HIGH=120

# Frecuencia cardíaca baja (bpm)
NOTIFICATION_HR_LOW=45

# SpO2 bajo (%)
NOTIFICATION_SPO2_LOW=92

# Nivel de estrés alto (0-100)
NOTIFICATION_STRESS_HIGH=80

# ============================================
# FRONTEND - URLs
# ============================================
# Puerto del frontend (8081 - EasyPanel reverse proxy maneja 80/443)
FRONTEND_PORT=8081

# URL del frontend (para CORS en backend)
# Para producción con dominio personalizado:
FRONTEND_URL=https://zepp.nodumstudio.com
# Para desarrollo local: http://localhost

# URL de la API del backend (desde el navegador del cliente)
# IMPORTANTE: Esta URL debe ser accesible desde el navegador
# IMPORTANTE: Usar HTTPS y WSS para Cloudflare
# Para producción con dominio:
NEXT_PUBLIC_API_URL=https://api.zepp.nodumstudio.com
# Para desarrollo local: http://localhost:8080

# URL de WebSocket (desde el navegador del cliente)
# Para producción con dominio:
NEXT_PUBLIC_WS_URL=wss://api.zepp.nodumstudio.com
# Para desarrollo local: ws://localhost:8080

# ============================================
# NOTAS IMPORTANTES
# ============================================
# 1. OPENAI_API_KEY: Sin esto no funcionará el análisis con IA
# 2. POSTGRES_PASSWORD: Usa una contraseña fuerte en producción
# 3. JWT_SECRET: Debe ser único y aleatorio
# 4. Para PRODUCCIÓN con dominio personalizado + EasyPanel + Cloudflare:
#    - FRONTEND_PORT=8081 (puerto interno - EasyPanel reverse proxy maneja 80/443)
#    - BACKEND_PORT=8080 (puerto interno)
#    - FRONTEND_URL=https://zepp.nodumstudio.com
#    - NEXT_PUBLIC_API_URL=https://api.zepp.nodumstudio.com
#    - NEXT_PUBLIC_WS_URL=wss://api.zepp.nodumstudio.com
#    - En EasyPanel: Configurar dominios apuntando a puertos 8081 y 8080
#    - En Cloudflare: SSL/TLS = Full o Full (strict)
#    - En Cloudflare: Proxy activado (nube naranja 🟠)
# 5. Para DESARROLLO local (localhost):
#    - FRONTEND_PORT=8081
#    - BACKEND_PORT=8080
#    - FRONTEND_URL=http://localhost:8081
#    - NEXT_PUBLIC_API_URL=http://localhost:8080
#    - NEXT_PUBLIC_WS_URL=ws://localhost:8080
# 6. IMPORTANTE: No expongas puerto 80/443 directamente en docker-compose
#    EasyPanel usa su reverse proxy (Traefik/Nginx) en esos puertos
